DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Role info_hr_app owns schema "hr" in database info_hr; no access to macs_legacy.
DATABASE_URL=postgres://info_hr_app:PASSWORD@localhost:5432/info_hr

# a chart or pivot money figure over fewer rows than this is hidden (0 or 1 turns it off)
REPORTS_MIN_GROUP=3

# Governed SQL on Firebird (app/hr_sql). The read-only login from scripts/grant_governed_fb.sql goes in
# FIREBIRD_GOVERNED_USER, with its password in FIREBIRD_GOVERNED_PASSWORD. The password is read only when the user is set.
# When FIREBIRD_GOVERNED_USER is unset, the default Firebird login is used (development only).
# FIREBIRD_GOVERNED_USER=
# FIREBIRD_GOVERNED_PASSWORD=
