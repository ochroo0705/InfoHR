{
  "name": "macs-human-capital-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "build": "npm run gen:api && tsc -b && vite build",
    "test": "vitest run",
    "parity": "playwright test",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@storybook/react": "8.6.19",
    "@storybook/react-vite": "8.6.19",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "storybook": "8.6.19",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
